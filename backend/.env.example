# ============================================================
# GLOBDE API — Variables de entorno (backend)
# Copia este archivo como .env y configura tus valores locales.
# Este ejemplo no apunta a la base de datos compartida ni incluye secretos.
# Nunca subas el archivo .env real al repositorio.
# ============================================================

# --- App ---
APP_NAME=GLOBDE API
APP_VERSION=2.0.0
APP_ENV=development
DEBUG=true

# --- Base de datos local ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=globde_dev
DB_PASSWORD=
DB_NAME=globde_dev
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT=10

# --- Autenticación JWT ---
# Genera un secreto local con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12

# --- Rate limiting de login ---
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Recuperación de contraseña ---
RESET_TOKEN_MINUTES=30

# --- Correo (SMTP) ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=example@invalid.test
SMTP_PASSWORD=
SMTP_FROM=example@invalid.test
SMTP_STARTTLS=true
SMTP_TIMEOUT=15

# --- Reglas de negocio ---
SLOT_STEP_MINUTOS=15
CANCELACION_HORAS_MINIMAS=2
PUNTO_VALOR_COP=100.0
IVA_PORCENTAJE=0.0
PENALIDAD_NO_ASISTENCIA=0.0
PENALIDAD_CANCELACION_TARDIA=0.0

# --- Niveles de fidelización ---
NIVEL_PLATA_DESDE=300
NIVEL_ORO_DESDE=700
NIVEL_DIAMANTE_DESDE=1500

# --- Compatibilidad ---
ENABLE_LEGACY_ROUTES=false
