# ============================================================
# GLOBDE API — Variables de entorno (backend)
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el .env real al repositorio (ya está en .gitignore).
# ============================================================

# --- App ---
APP_NAME=GLOBDE API
APP_VERSION=2.0.0
APP_ENV=development
DEBUG=true

# --- Base de datos (TiDB Cloud - Compartida en la nube) ---
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=2zMf9kVKhzVziZp.root
DB_PASSWORD=6mOEy2qqs8V4HAzk
DB_NAME=globde
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT=10
DATABASE_URL=mysql+pymysql://2zMf9kVKhzVziZp.root:6mOEy2qqs8V4HAzk@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/globde?ssl_verify_cert=true

# --- Autenticación JWT ---
# Genera un secreto real con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12

# --- Rate limiting de login ---
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=*

# --- Recuperación de contraseña ---
RESET_TOKEN_MINUTES=30

# --- Correo (SMTP) ---
# Para activar el envío real de correos, cambia EMAIL_ENABLED a true
# y completa SMTP_USER, SMTP_PASSWORD (App Password de Gmail) y SMTP_FROM.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_TIMEOUT=15

# --- Reglas de negocio ---
SLOT_STEP_MINUTOS=15
CANCELACION_HORAS_MINIMAS=2
PUNTO_VALOR_COP=100.0
IVA_PORCENTAJE=0.0
PENALIDAD_NO_ASISTENCIA=0.0
PENALIDAD_CANCELACION_TARDIA=0.0

# --- Niveles de fidelización ---
NIVEL_PLATA_DESDE=300
NIVEL_ORO_DESDE=700
NIVEL_DIAMANTE_DESDE=1500

# --- Compatibilidad ---
ENABLE_LEGACY_ROUTES=false