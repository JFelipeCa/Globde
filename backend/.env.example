# ============================================================
# GLOBDE API — Variables de entorno (backend)
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el .env real al repositorio (ya está en .gitignore).
# ============================================================

# --- App ---
APP_NAME=GLOBDE API
APP_VERSION=2.0.0
APP_ENV=development
DEBUG=true

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Obligatoria: sin esta variable, docker-compose no arranca (por diseño).
DB_PASSWORD=
DB_NAME=globde
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT=10

# --- Autenticación JWT ---
# Genera un secreto real con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12

# --- Rate limiting de login ---
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=*

# --- Recuperación de contraseña ---
RESET_TOKEN_MINUTES=30

# --- Correo (SMTP) ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Usa una contraseña de aplicación de Google, nunca la contraseña normal de Gmail.
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_TIMEOUT=15

# --- Reglas de negocio ---
SLOT_STEP_MINUTOS=15
CANCELACION_HORAS_MINIMAS=2
PUNTO_VALOR_COP=100.0
IVA_PORCENTAJE=0.0
PENALIDAD_NO_ASISTENCIA=0.0
PENALIDAD_CANCELACION_TARDIA=0.0

# --- Niveles de fidelización ---
NIVEL_PLATA_DESDE=300
NIVEL_ORO_DESDE=700
NIVEL_DIAMANTE_DESDE=1500

# --- Compatibilidad ---
# APAGADO por defecto: /api/datos exponía datos sin autenticación (RNF-001 / OWASP A01).
# Solo activarlo de forma transitoria si alguna pantalla aún llama al contrato v1.
ENABLE_LEGACY_ROUTES=false
